{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "playwithanyone-p2-local",
  "main": "../../apps/edge/src/index.ts",
  "compatibility_date": "2025-08-01",
  "workers_dev": false,
  "assets": { "directory": "../../apps/portal/dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "APP_ENV": "fixture", "WORKER_ROLE": "shell",
    "SHELL_ORIGIN": "http://127.0.0.1:18871",
    "GAME_ORIGINS": "http://localhost:18872", "ASSET_ORIGINS": "",
    "SESSION_TTL_SECONDS": "3600"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "playwithanyone-p2-fixture",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../apps/edge/migrations"
  }],
  "r2_buckets": [
    { "binding": "PUBLIC_BUILDS", "bucket_name": "playwithanyone-p2-public" },
    { "binding": "PRIVATE_STORAGE", "bucket_name": "playwithanyone-p2-private" }
  ]
}
