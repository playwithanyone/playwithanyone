{
  "name": "playwithanyone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free multiplayer browser games with one platform SDK.",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/verify.mjs",
    "verify": "npm test",
    "sync:preview": "bash scripts/remote-sync.sh --dry-run",
    "sync": "bash scripts/remote-sync.sh",
    "verify:remote": "bash scripts/remote-verify.sh",
    "build:portal": "vite build --config apps/portal/vite.config.ts",
    "dev:edge": "wrangler dev --config configs/fixtures/wrangler.p2.jsonc --ip 127.0.0.1 --port 18871 --persist-to .wrangler/p2",
    "check:p2": "npm run build && tsc -p apps/portal/tsconfig.json --noEmit && npm run build:portal && node scripts/verify-p2.mjs",
    "check:p3": "npm run build && tsc -p apps/portal/tsconfig.json --noEmit && npm run build:portal && node scripts/verify-p3.mjs",
    "prepare:connect-four": "node scripts/prepare-connect-four.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "publish:preview": "node scripts/publish-preview.mjs",
    "check:room-runtime": "npm run build && tsc -p apps/portal/tsconfig.json --noEmit && npm run build:portal && node scripts/verify-room-runtime.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "vite": "8.3.8",
    "wrangler": "4.29.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playwithanyone/playwithanyone.git"
  },
  "homepage": "https://playwithanyone.com",
  "bugs": {
    "url": "https://github.com/playwithanyone/playwithanyone/issues"
  }
}
